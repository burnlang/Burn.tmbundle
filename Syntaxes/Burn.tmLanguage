<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Burn</string>
	<key>scopeName</key>
	<string>source.burn</string>
	<key>fileTypes</key>
	<array>
		<string>bn</string>
	</array>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#comments</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#annotations</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#definitions</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#functions</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#keywords</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#strings</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#numbers</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#types</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#calls</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#operators</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>comments</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>comment.line.double-slash.burn</string>
					<key>match</key>
					<string>//.*$</string>
				</dict>
				<dict>
					<key>name</key>
					<string>comment.block.burn</string>
					<key>begin</key>
					<string>/\*</string>
					<key>end</key>
					<string>\*/</string>
				</dict>
			</array>
		</dict>
		<key>annotations</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>(@)([A-Za-z_][A-Za-z0-9_]*)</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.annotation.burn</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>storage.type.annotation.burn</string>
						</dict>
					</dict>
				</dict>
			</array>
		</dict>
		<key>definitions</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b(def)\s+(type|struct|record|interface|trait|class|enum|annotation)\s+([A-Za-z_][A-Za-z0-9_]*)</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>keyword.declaration.burn</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>storage.type.burn</string>
						</dict>
						<key>3</key>
						<dict>
							<key>name</key>
							<string>entity.name.type.burn</string>
						</dict>
					</dict>
				</dict>
			</array>
		</dict>
		<key>functions</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b(fun)\s+([A-Za-z_][A-Za-z0-9_]*)</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>keyword.declaration.function.burn</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>entity.name.function.burn</string>
						</dict>
					</dict>
				</dict>
			</array>
		</dict>
		<key>keywords</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>keyword.control.burn</string>
					<key>match</key>
					<string>\b(if|else|while|for|in|return|break|continue|await|import)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.declaration.burn</string>
					<key>match</key>
					<string>\b(fun|var|const|def|async|static|pub|priv)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.word.burn</string>
					<key>match</key>
					<string>\b(is|as)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.language.burn</string>
					<key>match</key>
					<string>\b(true|false|null)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>variable.language.self.burn</string>
					<key>match</key>
					<string>\bself\b</string>
				</dict>
			</array>
		</dict>
		<key>strings</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>string.quoted.double.burn</string>
					<key>begin</key>
					<string>"</string>
					<key>end</key>
					<string>"</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>include</key>
							<string>#escapes</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#interpolation</string>
						</dict>
					</array>
				</dict>
				<dict>
					<key>name</key>
					<string>string.quoted.single.burn</string>
					<key>begin</key>
					<string>'</string>
					<key>end</key>
					<string>'</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>include</key>
							<string>#escapes</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#interpolation</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
		<key>escapes</key>
		<dict>
			<key>name</key>
			<string>constant.character.escape.burn</string>
			<key>match</key>
			<string>\\(n|t|r|0|"|'|\\|\$|u\{[0-9A-Fa-f]+\})</string>
		</dict>
		<key>interpolation</key>
		<dict>
			<key>name</key>
			<string>meta.interpolation.burn</string>
			<key>begin</key>
			<string>\$\{</string>
			<key>end</key>
			<string>\}</string>
			<key>beginCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.interpolation.begin.burn</string>
				</dict>
			</dict>
			<key>endCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.section.interpolation.end.burn</string>
				</dict>
			</dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>$self</string>
				</dict>
			</array>
		</dict>
		<key>numbers</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.numeric.hex.burn</string>
					<key>match</key>
					<string>\b0[xX][0-9A-Fa-f_]+\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.numeric.binary.burn</string>
					<key>match</key>
					<string>\b0[bB][01_]+\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.numeric.burn</string>
					<key>match</key>
					<string>\b[0-9][0-9_]*(\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?\b</string>
				</dict>
			</array>
		</dict>
		<key>types</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>support.type.primitive.burn</string>
					<key>match</key>
					<string>\b(int|float|string|bool|void|any|Int|Float|String|Bool|Void|Any|Future)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>entity.name.type.burn</string>
					<key>match</key>
					<string>\b[A-Z][A-Za-z0-9_]*\b</string>
				</dict>
			</array>
		</dict>
		<key>calls</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b([a-z_][A-Za-z0-9_]*)\s*(?=\()</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>entity.name.function.call.burn</string>
						</dict>
					</dict>
				</dict>
			</array>
		</dict>
		<key>operators</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>keyword.operator.range.burn</string>
					<key>match</key>
					<string>\.\.=?</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.comparison.burn</string>
					<key>match</key>
					<string>==|!=|&lt;=|&gt;=|&lt;|&gt;</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.logical.burn</string>
					<key>match</key>
					<string>&amp;&amp;|\|\||!</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.assignment.burn</string>
					<key>match</key>
					<string>\+=|-=|\*=|/=|%=|=</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.arithmetic.burn</string>
					<key>match</key>
					<string>\+|-|\*|/|%</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.nullable.burn</string>
					<key>match</key>
					<string>\?</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>uuid</key>
	<string>54DF2D8F-9E56-4764-999A-69452096E63A</string>
</dict>
</plist>
